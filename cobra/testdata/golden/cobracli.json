        "cascading": true,
        "short_circuit": true,
        "schema": {
          "type": "bool"
        },
        "builtin": "help"
      },
      {
        "name": "config",
        "summary": "config file (default is $HOME/.acmecli.yaml)",
        "identifiers": [
          "--config"
        ],
        "cascading": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "toggle",
        "summary": "Help message for toggle",
        "identifiers": [
          "-t",
          "--toggle"
        ],
        "schema": {
          "type": "bool"
        }
      }
    ],
    "commands": [
      {
        "name": "completion",
        "summary": "Generate the autocompletion script for the specified shell",
        "arguments": [
          {
            "name": "shell",
            "schema": {
              "type": "string",
              "required": true,
              "enum": [
                {
                  "value": "bash"
                },
                {
                  "value": "fish"
                },
                {
                  "value": "powershell"
                },
                {
                  "value": "zsh"
                }

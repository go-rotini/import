  "command": {
    "name": "acmecli",
    "summary": "A brief description of your application",
    "description": "A longer description that spans multiple lines and likely contains\nexamples and usage of using your application.",
    "flags": [
      {
        "name": "help",
        "summary": "help for acmecli",
        "identifiers": [
          "-h",
          "--help"

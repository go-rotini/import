            "arguments": [
              {
                "name": "key",
                "schema": {
                  "type": "string",
                  "required": true
                }
              },
              {
                "name": "default",
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "args",
                "summary": "further arguments",
                "schema": {
                  "type": "[]string"
                }
              }
            ]
          }
        ]
      },
      {
        "name": "help",
        "summary": "Help about any command",
        "arguments": [
          {
            "name": "command",
            "schema": {
              "type": "[]string"
            }
          }
        ],
        "builtin": "help"
      },
      {
        "name": "serve",
        "summary": "Start the server",
        "description": "Start the HTTP server on the configured port.",
        "arguments": [
          {
            "name": "args",
            "summary": "further arguments",
            "schema": {
              "type": "[]string"
            }
          }
        ],
        "flags": [
          {
            "name": "port",
            "summary": "port to listen on",
            "identifiers": [
              "-p",
              "--port"
            ],
            "schema": {
              "type": "int",
              "default": 8080
            }
          }
        ]
      }
    ]

              "type": "bool"
            }
          }
        ],
        "builtin": "completion"
      },
      {
        "name": "config",
        "summary": "Read and write settings",
        "commands": [
          {
            "name": "get",
            "summary": "Print one setting",
            "examples": [
              "acmecli config get port",
              "acmecli config get region us-east-1"
